// Terminal Theme System Variables
// ================================

// Config
support-for-ie = false
vendor-prefixes = webkit moz ms official

// ============================================
// CSS Variables for Terminal Theme System
// ============================================
:root
  // Base Colors
  --terminal-bg: #0d1117
  --terminal-bg-secondary: #161b22
  --terminal-bg-tertiary: #21262d
  --terminal-bg-hover: #1c2128
  
  // Text Colors
  --terminal-text: #c9d1d9
  --terminal-text-secondary: #8b949e
  --terminal-text-muted: #6e7681
  --terminal-text-inverse: #0d1117
  
  // Accent Colors (Classic Blue)
  --terminal-accent: #58a6ff
  --terminal-accent-rgb: 88, 166, 255
  --terminal-accent-hover: #79b8ff
  --terminal-success: #238636
  --terminal-warning: #d29922
  --terminal-error: #da3633
  --terminal-info: #58a6ff
  
  // Border & Shadow
  --terminal-border: #30363d
  --terminal-border-hover: #58a6ff
  --terminal-border-light: #21262d
  --terminal-glow: rgba(88, 166, 255, 0.3)
  --terminal-glow-strong: rgba(88, 166, 255, 0.5)
  
  // Typography
  --terminal-font: 'JetBrains Mono', 'Fira Code', 'Source Code Pro', Consolas, Monaco, monospace
  --terminal-font-size: 16px
  --terminal-font-size-sm: 14px
  --terminal-font-size-lg: 18px
  --terminal-line-height: 1.6
  
  // Spacing System (4px base)
  --terminal-space-xs: 4px
  --terminal-space-sm: 8px
  --terminal-space-md: 16px
  --terminal-space-lg: 24px
  --terminal-space-xl: 32px
  --terminal-space-2xl: 48px
  
  // Transitions
  --terminal-transition-fast: 150ms ease
  --terminal-transition-normal: 300ms ease
  --terminal-transition-slow: 500ms ease
  
  // Layout
  --terminal-max-width: 1400px
  --terminal-header-height: 60px
  --terminal-radius: 4px
  --terminal-radius-sm: 2px

// ============================================
// Theme: Amber Monochrome
// ============================================
[data-theme="amber"]
  --terminal-bg: #1a0f00
  --terminal-bg-secondary: #2a1a00
  --terminal-bg-tertiary: #3d2500
  --terminal-bg-hover: #2d1a05
  
  --terminal-text: #ffb000
  --terminal-text-secondary: #cc8a00
  --terminal-text-muted: #996600
  --terminal-text-inverse: #1a0f00
  
  --terminal-accent: #ffcc00
  --terminal-accent-rgb: 255, 204, 0
  --terminal-accent-hover: #ffe033
  --terminal-success: #88ff00
  --terminal-warning: #ff8800
  --terminal-error: #ff4400
  --terminal-info: #ffcc00
  
  --terminal-border: #4d3000
  --terminal-border-hover: #ffcc00
  --terminal-border-light: #2a1a00
  --terminal-glow: rgba(255, 204, 0, 0.3)
  --terminal-glow-strong: rgba(255, 204, 0, 0.5)
  
  --terminal-font: 'VT323', 'Share Tech Mono', 'Courier New', monospace
  --terminal-font-size: 18px

// ============================================
// Theme: Cyberpunk
// ============================================
[data-theme="cyberpunk"]
  --terminal-bg: #0a0a0f
  --terminal-bg-secondary: #12121a
  --terminal-bg-tertiary: #1a1a28
  --terminal-bg-hover: #151520
  
  --terminal-text: #e0e0ff
  --terminal-text-secondary: #a0a0d0
  --terminal-text-muted: #606090
  --terminal-text-inverse: #0a0a0f
  
  --terminal-accent: #ff00ff
  --terminal-accent-rgb: 255, 0, 255
  --terminal-accent-hover: #ff44ff
  --terminal-success: #00ff9f
  --terminal-warning: #ffee00
  --terminal-error: #ff0066
  --terminal-info: #00ffff
  
  --terminal-border: #2a1a3a
  --terminal-border-hover: #ff00ff
  --terminal-border-light: #1a0a2a
  --terminal-glow: rgba(255, 0, 255, 0.4)
  --terminal-glow-strong: rgba(255, 0, 255, 0.6)
  
  --terminal-font: 'Orbitron', 'Rajdhani', 'Courier New', monospace
  --terminal-font-size: 15px

// ============================================
// Theme: Matrix Green
// ============================================
[data-theme="matrix"]
  --terminal-bg: #000000
  --terminal-bg-secondary: #001100
  --terminal-bg-tertiary: #002200
  --terminal-bg-hover: #001a00
  
  --terminal-text: #00ff41
  --terminal-text-secondary: #00cc33
  --terminal-text-muted: #008822
  --terminal-text-inverse: #000000
  
  --terminal-accent: #00ff41
  --terminal-accent-rgb: 0, 255, 65
  --terminal-accent-hover: #55ff77
  --terminal-success: #00ff41
  --terminal-warning: #55ff55
  --terminal-error: #ff0000
  --terminal-info: #00ff41
  
  --terminal-border: #003300
  --terminal-border-hover: #00ff41
  --terminal-border-light: #001100
  --terminal-glow: rgba(0, 255, 65, 0.3)
  --terminal-glow-strong: rgba(0, 255, 65, 0.5)
  
  --terminal-font: 'Courier Prime', 'Courier New', monospace
  --terminal-font-size: 16px

// ============================================
// Theme: Minimal Gray
// ============================================
[data-theme="minimal"]
  --terminal-bg: #1a1a1a
  --terminal-bg-secondary: #222222
  --terminal-bg-tertiary: #2a2a2a
  --terminal-bg-hover: #252525
  
  --terminal-text: #e5e5e5
  --terminal-text-secondary: #999999
  --terminal-text-muted: #666666
  --terminal-text-inverse: #1a1a1a
  
  --terminal-accent: #ffffff
  --terminal-accent-rgb: 255, 255, 255
  --terminal-accent-hover: #f0f0f0
  --terminal-success: #a0a0a0
  --terminal-warning: #808080
  --terminal-error: #404040
  --terminal-info: #c0c0c0
  
  --terminal-border: #333333
  --terminal-border-hover: #ffffff
  --terminal-border-light: #2a2a2a
  --terminal-glow: rgba(255, 255, 255, 0.15)
  --terminal-glow-strong: rgba(255, 255, 255, 0.25)
  
  --terminal-font: 'IBM Plex Mono', 'Roboto Mono', monospace
  --terminal-font-size: 15px

// ============================================
// Legacy Variables (for backward compatibility)
// ============================================
color-default = #c9d1d9
color-grey = #8b949e
color-border = #30363d
color-link = #58a6ff
color-background = #0d1117
color-sidebar-text = #8b949e
color-widget-background = #161b22
color-widget-border = #30363d
color-footer-background = #161b22
color-mobile-nav-background = #161b22

// Gradient Colors (mapped to terminal accent)
color-primary = #58a6ff
color-secondary = #79b8ff
color-accent = #58a6ff
color-gradient-start = #58a6ff
color-gradient-end = #79b8ff
color-card-bg = #161b22
color-card-hover = #1c2128

// Fonts
font-sans = 'JetBrains Mono', 'Fira Code', monospace
font-serif = 'JetBrains Mono', 'Fira Code', monospace
font-mono = 'JetBrains Mono', 'Fira Code', monospace
font-icon = FontAwesome
font-icon-path = "fonts/fontawesome-webfont"
font-icon-version = "4.0.3"
font-size = 16px
line-height = 1.6
line-height-title = 1.3

// Layout
block-margin = 24px
article-padding = 24px
mobile-nav-width = 280px
main-column = 9
sidebar-column = 3

// Header
logo-size = 70px
logo-weight = 700
subtitle-size = 20px
subtitle-line = 36px
banner-height = 500px
banner-url = ""

// Sidebar
sidebar = hexo-config("sidebar")

if sidebar and sidebar isnt bottom
  _sidebar-column = sidebar-column
else
  _sidebar-column = 0

// Grids
column-width = 80px
gutter-width = 20px
columns = main-column + _sidebar-column

// Media queries
mq-mobile = "screen and (max-width: 767px)"
mq-tablet = "screen and (min-width: 768px) and (max-width: 1023px)"
mq-normal = "screen and (min-width: 1024px)"

// Legacy Design Tokens
border-radius-sm = 2px
border-radius-md = 4px
border-radius-lg = 4px
border-radius-xl = 4px
shadow-sm = 0 0 10px rgba(88, 166, 255, 0.1)
shadow-md = 0 0 20px rgba(88, 166, 255, 0.2)
shadow-lg = 0 0 40px rgba(88, 166, 255, 0.3)
shadow-xl = 0 0 60px rgba(88, 166, 255, 0.3)
transition-fast = 150ms ease
transition-normal = 300ms ease
transition-slow = 500ms ease
