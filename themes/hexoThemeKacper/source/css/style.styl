@import "nib"
@import "_variables"
@import "_util/mixin"
@import "_util/grid"

// ============================================
// Google Fonts Import
// ============================================
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=VT323&family=Orbitron:wght@400;500;600;700&family=Courier+Prime:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600&family=Fira+Code:wght@400;500;600&display=swap')

global-reset()

// ============================================
// Font Face - FontAwesome
// ============================================
@font-face
  font-family: 'FontAwesome'
  src: url('fonts/fontawesome-webfont.eot?v=4.0.3')
  src: url('fonts/fontawesome-webfont.eot?#iefix&v=4.0.3') format('embedded-opentype'),
       url('fonts/fontawesome-webfont.woff2?v=4.0.3') format('woff2'),
       url('fonts/fontawesome-webfont.woff?v=4.0.3') format('woff'),
       url('fonts/fontawesome-webfont.ttf?v=4.0.3') format('truetype'),
       url('fonts/fontawesome-webfont.svg?v=4.0.3#fontawesomeregular') format('svg')
  font-weight: normal
  font-style: normal

// ============================================
// Global Styles & Theme Transitions
// ============================================
*, *::before, *::after
  transition: background-color var(--terminal-transition-normal),
              color var(--terminal-transition-normal),
              border-color var(--terminal-transition-normal),
              box-shadow var(--terminal-transition-normal)

html, body, #container
  height: 100%

body
  background: var(--terminal-bg)
  color: var(--terminal-text)
  font-family: var(--terminal-font)
  font-size: var(--terminal-font-size)
  line-height: var(--terminal-line-height)
  -webkit-text-size-adjust: 100%
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
  overflow-x: hidden

// Selection style
::selection
  background: var(--terminal-accent)
  color: var(--terminal-text-inverse)

// Scrollbar styling
::-webkit-scrollbar
  width: 8px
  height: 8px

::-webkit-scrollbar-track
  background: var(--terminal-bg-secondary)

::-webkit-scrollbar-thumb
  background: var(--terminal-border)
  border-radius: 4px
  &:hover
    background: var(--terminal-accent)

// ============================================
// Terminal Cursor Animation
// ============================================
@keyframes cursor-blink
  0%, 50%
    opacity: 1
  51%, 100%
    opacity: 0

.terminal-cursor
  display: inline-block
  width: 10px
  height: 1.2em
  background: var(--terminal-accent)
  margin-left: 2px
  vertical-align: text-bottom
  animation: cursor-blink 1s step-end infinite

.typewriter-cursor
  display: inline-block
  width: 10px
  height: 1.2em
  background: var(--terminal-accent)
  margin-left: 2px
  vertical-align: text-bottom
  animation: cursor-blink 1s step-end infinite

// ============================================
// Terminal Window Component
// ============================================
.terminal-window
  background: var(--terminal-bg-secondary)
  border: 1px solid var(--terminal-border)
  border-radius: var(--terminal-radius)
  overflow: hidden
  margin-bottom: var(--terminal-space-lg)
  box-shadow: 0 0 20px var(--terminal-glow)
  transition: all var(--terminal-transition-normal)
  
  &:hover
    border-color: var(--terminal-border-hover)
    box-shadow: 0 0 30px var(--terminal-glow-strong)

.terminal-header
  background: var(--terminal-bg-tertiary)
  padding: var(--terminal-space-sm) var(--terminal-space-md)
  display: flex
  align-items: center
  gap: var(--terminal-space-sm)
  border-bottom: 1px solid var(--terminal-border)

.terminal-controls
  display: flex
  gap: 6px

.terminal-btn
  width: 12px
  height: 12px
  border-radius: 50%
  display: block
  
  &.close
    background: var(--terminal-error)
  
  &.minimize
    background: var(--terminal-warning)
  
  &.maximize
    background: var(--terminal-success)

.terminal-title
  flex: 1
  text-align: center
  color: var(--terminal-text-secondary)
  font-size: var(--terminal-font-size-sm)

.terminal-body
  padding: var(--terminal-space-md)

.terminal-line
  display: flex
  align-items: flex-start
  gap: var(--terminal-space-sm)
  margin-bottom: var(--terminal-space-sm)

.terminal-prompt
  color: var(--terminal-success)
  font-weight: 600
  user-select: none

.terminal-command
  color: var(--terminal-text)

.terminal-output
  color: var(--terminal-text-secondary)
  padding-left: var(--terminal-space-md)

// ============================================
// Links
// ============================================
a
  color: var(--terminal-accent)
  text-decoration: none
  position: relative
  transition: all var(--terminal-transition-fast)
  
  &:hover
    color: var(--terminal-accent-hover)
    text-shadow: 0 0 10px var(--terminal-glow)
    
    &::after
      content: ''
      position: absolute
      bottom: -2px
      left: 0
      width: 100%
      height: 1px
      background: var(--terminal-accent)
      box-shadow: 0 0 5px var(--terminal-glow)

// ============================================
// Layout
// ============================================
.outer
  clearfix()
  margin: 0 auto
  padding: 0 var(--terminal-space-lg)
  max-width: var(--terminal-max-width)
  @media mq-mobile
    padding: 0 var(--terminal-space-md)

.inner
  column(columns)

.left, .alignleft
  float: left

.right, .alignright
  float: right

.clear
  clear: both

#container
  position: relative
  background: var(--terminal-bg)
  min-height: 100vh

.mobile-nav-on
  overflow: hidden

#wrap
  height: 100%
  width: 100%
  position: absolute
  top: 0
  left: 0
  transition: 0.2s ease-out
  z-index: 1
  background: transparent
  .mobile-nav-on &
    left: mobile-nav-width

if sidebar is left
  #main
    float: right

// ============================================
// Typography
// ============================================
h1, h2, h3, h4, h5, h6
  font-family: var(--terminal-font)
  font-weight: 600
  line-height: var(--line-height-title)
  color: var(--terminal-text)
  margin-bottom: var(--terminal-space-md)

h1
  font-size: 2rem
  
h2
  font-size: 1.75rem
  
h3
  font-size: 1.5rem
  
h4
  font-size: 1.25rem
  
h5
  font-size: 1.125rem
  
h6
  font-size: 1rem

p
  margin-bottom: var(--terminal-space-md)
  color: var(--terminal-text)

// Code styling
code
  background: var(--terminal-bg-tertiary)
  color: var(--terminal-accent)
  padding: 2px 6px
  border-radius: var(--terminal-radius-sm)
  font-family: var(--terminal-font)
  font-size: 0.9em

pre
  background: var(--terminal-bg-secondary)
  border: 1px solid var(--terminal-border)
  border-radius: var(--terminal-radius)
  padding: var(--terminal-space-md)
  overflow-x: auto
  margin-bottom: var(--terminal-space-lg)
  
  code
    background: transparent
    padding: 0
    color: var(--terminal-text)

// ============================================
// Buttons
// ============================================
.btn, .page-btn, button
  display: inline-block
  background: transparent
  color: var(--terminal-accent)
  border: 1px solid var(--terminal-accent)
  padding: var(--terminal-space-sm) var(--terminal-space-md)
  font-family: var(--terminal-font)
  font-size: var(--terminal-font-size)
  cursor: pointer
  transition: all var(--terminal-transition-fast)
  text-decoration: none
  border-radius: var(--terminal-radius-sm)
  
  &:hover
    background: var(--terminal-accent)
    color: var(--terminal-text-inverse)
    box-shadow: 0 0 15px var(--terminal-glow)
    text-shadow: none
    
    &::after
      display: none
  
  &:active
    transform: translateY(1px)
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.3)

// ============================================
// Form Elements
// ============================================
input, textarea
  background: var(--terminal-bg-secondary)
  border: 1px solid var(--terminal-border)
  color: var(--terminal-text)
  padding: var(--terminal-space-sm) var(--terminal-space-md)
  font-family: var(--terminal-font)
  font-size: var(--terminal-font-size)
  border-radius: 0
  transition: all var(--terminal-transition-fast)
  
  &:focus
    outline: none
    border-color: var(--terminal-accent)
    box-shadow: 0 0 10px var(--terminal-glow)
  
  &::placeholder
    color: var(--terminal-text-muted)

// ============================================
// Theme Switcher Component
// ============================================
.theme-switcher
  position: fixed
  top: var(--terminal-space-lg)
  right: var(--terminal-space-lg)
  z-index: 1000
  
  @media mq-mobile
    top: var(--terminal-space-sm)
    right: var(--terminal-space-sm)

.theme-btn
  background: var(--terminal-bg-secondary)
  border: 1px solid var(--terminal-border)
  color: var(--terminal-text)
  padding: var(--terminal-space-sm) var(--terminal-space-md)
  font-family: var(--terminal-font)
  cursor: pointer
  display: flex
  align-items: center
  gap: var(--terminal-space-sm)
  border-radius: var(--terminal-radius)
  transition: all var(--terminal-transition-fast)
  
  &:hover
    border-color: var(--terminal-accent)
    box-shadow: 0 0 15px var(--terminal-glow)

.theme-icon
  font-size: 1.2em

.theme-name
  font-size: var(--terminal-font-size-sm)
  
  @media mq-mobile
    display: none

.theme-dropdown
  position: absolute
  top: 100%
  right: 0
  margin-top: var(--terminal-space-sm)
  background: var(--terminal-bg-secondary)
  border: 1px solid var(--terminal-border)
  border-radius: var(--terminal-radius)
  min-width: 160px
  opacity: 0
  visibility: hidden
  transform: translateY(-10px)
  transition: all var(--terminal-transition-fast)
  box-shadow: 0 10px 30px rgba(0,0,0,0.5)
  
  &.active
    opacity: 1
    visibility: visible
    transform: translateY(0)

.theme-option
  display: flex
  align-items: center
  gap: var(--terminal-space-sm)
  padding: var(--terminal-space-sm) var(--terminal-space-md)
  width: 100%
  background: transparent
  border: none
  color: var(--terminal-text)
  font-family: var(--terminal-font)
  cursor: pointer
  text-align: left
  transition: all var(--terminal-transition-fast)
  
  &:hover
    background: var(--terminal-bg-hover)
    color: var(--terminal-accent)
  
  &.active
    background: var(--terminal-bg-tertiary)
    color: var(--terminal-accent)
    
    &::before
      content: '>'
      color: var(--terminal-accent)
      margin-right: var(--terminal-space-xs)

.theme-option-icon
  font-size: 1.1em

// ============================================
// Reduced Motion Support
// ============================================
@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration: 0.01ms !important
    animation-iteration-count: 1 !important
    transition-duration: 0.01ms !important
  
  .terminal-cursor,
  .typewriter-cursor
    animation: none
    opacity: 1

// ============================================
// Import Partials
// ============================================
@import "_extend"
@import "_partial/header"
@import "_partial/article"
@import "_partial/comment"
@import "_partial/archive"
@import "_partial/footer"
@import "_partial/highlight"
@import "_partial/mobile"
@import "_partial/language-switcher"

if sidebar
  @import "_partial/sidebar"
