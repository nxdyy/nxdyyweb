// ============================================
// Terminal Style Footer
// ============================================

#footer
  background: var(--terminal-bg-secondary)
  padding: var(--terminal-space-xl) 0 var(--terminal-space-lg)
  color: var(--terminal-text-secondary)
  position: relative
  overflow: hidden
  border-top: 1px solid var(--terminal-border)
  box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.2)
  font-family: var(--terminal-font)
  
  // Terminal scanline effect
  &::before
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.02) 2px,
      rgba(0, 0, 0, 0.02) 4px
    )
    pointer-events: none
    z-index: 1
  
  a
    color: var(--terminal-accent)
    text-decoration: none
    transition: all var(--terminal-transition-fast)
    position: relative
    
    &::after
      content: ''
      position: absolute
      bottom: -2px
      left: 0
      width: 0
      height: 1px
      background: var(--terminal-accent)
      transition: width var(--terminal-transition-normal)
      box-shadow: 0 0 5px var(--terminal-glow)
    
    &:hover
      text-decoration: none
      color: var(--terminal-accent-hover)
      text-shadow: 0 0 10px var(--terminal-glow)
      
      &::after
        width: 100%

#footer-info
  line-height: var(--terminal-line-height)
  font-size: var(--terminal-font-size-sm)
  display: flex
  justify-content: space-between
  align-items: center
  flex-wrap: wrap
  gap: var(--terminal-space-md)
  position: relative
  z-index: 2
  
  .left
    text-align: left
    color: var(--terminal-text-muted)
    
    // Terminal prompt style
    &::before
      content: '$ '
      color: var(--terminal-success)
      font-weight: 600
  
  .right
    display: flex
    gap: var(--terminal-space-sm)
    flex-wrap: wrap
    
    a
      padding: var(--terminal-space-xs) var(--terminal-space-sm)
      background: var(--terminal-bg-tertiary)
      border-radius: var(--terminal-radius-sm)
      transition: all var(--terminal-transition-fast)
      color: var(--terminal-text-secondary)
      border: 1px solid var(--terminal-border)
      font-size: var(--terminal-font-size-sm)
      
      &::after
        display: none
      
      &:hover
        background: var(--terminal-accent)
        color: var(--terminal-text-inverse)
        border-color: var(--terminal-accent)
        box-shadow: 0 0 15px var(--terminal-glow)
        transform: translateY(-2px)

#footer-custom
  margin-top: var(--terminal-space-lg)
  padding-top: var(--terminal-space-md)
  border-top: 1px solid var(--terminal-border)
  text-align: center
  color: var(--terminal-text-muted)
  font-size: var(--terminal-font-size-sm)
  line-height: var(--terminal-line-height)
  position: relative
  z-index: 2
  
  a
    color: var(--terminal-accent)
    font-weight: 500
    transition: color var(--terminal-transition-fast)
    
    &:hover
      color: var(--terminal-accent-hover)

// Terminal status line
.footer-status
  display: flex
  justify-content: center
  align-items: center
  gap: var(--terminal-space-lg)
  margin-bottom: var(--terminal-space-md)
  font-size: var(--terminal-font-size-sm)
  color: var(--terminal-text-muted)
  flex-wrap: wrap
  
  .status-item
    display: flex
    align-items: center
    gap: var(--terminal-space-xs)
    
    .status-indicator
      width: 8px
      height: 8px
      border-radius: 50%
      background: var(--terminal-success)
      box-shadow: 0 0 5px var(--terminal-success)
      animation: pulse 2s ease-in-out infinite

@keyframes pulse
  0%, 100%
    opacity: 1
  50%
    opacity: 0.5

// Terminal command line
.footer-command
  text-align: center
  margin-top: var(--terminal-space-md)
  font-size: var(--terminal-font-size-sm)
  color: var(--terminal-text-secondary)
  
  .prompt
    color: var(--terminal-success)
    font-weight: 600
    margin-right: var(--terminal-space-xs)
  
  .command
    color: var(--terminal-accent)
  
  .cursor
    display: inline-block
    width: 8px
    height: 1em
    background: var(--terminal-accent)
    margin-left: 2px
    vertical-align: text-bottom
    animation: cursor-blink 1s step-end infinite
