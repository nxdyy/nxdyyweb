<%if(page.type !== 'API'){%>

<footer id="footer">
  <% if (theme.sidebar === 'bottom'){%>
    <%- partial('_partial/sidebar') %>
  <% } %>
  <div class="outer">
    <!-- Terminal Status Line -->
    <div class="footer-status inner">
      <div class="status-item">
        <span class="status-indicator"></span>
        <span data-i18n="footer.systemOnline">SYSTEM ONLINE</span>
      </div>
      <div class="status-item">
        <span data-i18n="footer.theme">THEME</span>: <span id="current-theme-name">CLASSIC</span>
      </div>
      <div class="status-item">
        <span data-i18n="footer.build">BUILD</span>: <%= date(new Date(), 'YYYYMMDD') %>
      </div>
    </div>
    
    <div id="footer-info" class="inner">
        <div class="left">
            &copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title %><br>
            Powered by <a href="http://hexo.io/" target="_blank">Hexo</a> :: Theme by <a href="https://github.com/jaywcjlove/hexoThemeKacper">hexoThemeKacper</a>
        </div>
        <div class="right">
            <% for(a in config.social){%>
                <a href="<%=config.social[a]%>"><%=a%></a>
            <%}%>
        </div>
    </div>
    
    <!-- Terminal Command Line -->
    <div class="footer-command inner">
      <span class="prompt">$</span>
      <span class="command" data-i18n="footer.thanks">Thanks for visiting!</span>
      <span class="cursor"></span>
    </div>
    
    <% if (theme.footer_content){ %>
    <div id="footer-custom" class="inner">
      <%- theme.footer_content %>
    </div>
    <% } %>
    
    <% if (theme.busuanzi !== false){ %>
    <div id="footer-custom" class="inner" style="text-align: center; margin-top: var(--terminal-space-md); padding-top: var(--terminal-space-md); border-top: 1px solid var(--terminal-border);">
      <span id="busuanzi_container_site_pv" style="display: none; margin: 0 10px;">
        <span class="prompt">$</span> <span data-i18n="footer.visits">Total visits</span>: <span id="busuanzi_value_site_pv"></span>
      </span>
      <span id="busuanzi_container_site_uv" style="display: none; margin: 0 10px;">
        <span class="prompt">$</span> <span data-i18n="footer.visitors">Unique visitors</span>: <span id="busuanzi_value_site_uv"></span>
      </span>
      <span id="busuanzi_container_page_pv" style="display: none; margin: 0 10px;">
        <span class="prompt">$</span> <span data-i18n="footer.pageViews">Page views</span>: <span id="busuanzi_value_page_pv"></span>
      </span>
    </div>
    <script src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
    <% } %>
  </div>
</footer>

<script>
// Update theme name in footer when theme changes
document.addEventListener('DOMContentLoaded', function() {
  function updateThemeName() {
    const themeNames = {
      'classic': 'CLASSIC TERMINAL',
      'amber': 'AMBER MONOCHROME',
      'cyberpunk': 'CYBERPUNK',
      'matrix': 'MATRIX GREEN',
      'minimal': 'MINIMAL GRAY'
    };
    
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'classic';
    const themeNameEl = document.getElementById('current-theme-name');
    if (themeNameEl) {
      themeNameEl.textContent = themeNames[currentTheme] || 'CLASSIC';
    }
  }
  
  // Initial update
  updateThemeName();
  
  // Listen for theme changes
  window.addEventListener('themechange', updateThemeName);
});
</script>

<% if (theme.fancybox){ %>
  <%- css('fancybox/jquery.fancybox') %>
  <%- js('fancybox/jquery.fancybox.pack') %>
<%}else{%>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function(){
  var images = document.querySelectorAll('.article-entry img');
  images.forEach(function(img) {
    var parent = img.parentElement;
    if (!parent) return;
    var grandparent = parent.parentElement;
    if (grandparent && grandparent.tagName === 'A') {
      parent.setAttribute('href', grandparent.getAttribute('href'));
    }
  });
});
</script>
<%} %>

<script src="/js/script.js?v=20260518001" defer></script>
<%}%>
