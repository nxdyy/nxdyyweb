<% 
var ispage = false
    hdpage =""
    ishome = url_for(page.path) === '/index.html'? true :false

console.log(url_for(page.path));

if(!ishome){
    hdpage ="hdpage"
    ispage = true
}else{
  hdpage ="header"
}
%>
<header id="header" class="<%=hdpage%>">
    <%if(!ispage){%>
    <div id="banner">
        <div class="terminal-overlay"></div>
    </div>
    <%}%>
    <div id="header-outer" class="outer">
        <%if(!ispage){%>
        <div id="header-title" class="inner">
          <h1 id="logo-wrap">
            <a href="<%- url_for() %>" id="logo" data-typewriter data-typewriter-speed="100" data-typewriter-delay="300">
              <%= config.title %>
            </a>
            <span class="terminal-cursor"></span>
          </h1>
          <% if (theme.subtitle){ %>
            <h2 id="subtitle-wrap">
              <a href="<%- url_for() %>" id="subtitle" data-typewriter data-typewriter-speed="80" data-typewriter-delay="1500">
                <%= theme.subtitle %>
              </a>
            </h2>
          <% } %>
          <div class="page-buttons">
            <a class="page-btn terminal-btn-style" href="https://www.nxdyy.cn/archives">
              <span class="prompt">$</span> 查看相关项目
            </a>
            <a class="page-btn terminal-btn-style" href="https://blog.nxdyy.cn">
              <span class="prompt">$</span> nxdyy的个人博客
            </a>
          </div>
        </div>
        <%}%>
        <div id="header-inner" class="inner">
          <nav id="main-nav">
            <a id="main-nav-toggle" class="nav-icon"></a>
            <% for (var i in theme.menu){ %>
              <a class="main-nav-link" href="<%- url_for(theme.menu[i]) %>">
                  <span class="nav-prompt">></span> <%= i %>
              </a>
            <% } %>
          </nav>
          <nav id="sub-nav">
            <% if (theme.rss){ %>
              <a id="nav-rss-link" class="nav-icon" href="<%- theme.rss %>" title="RSS Feed" data-i18n-attr="title" data-i18n="nav.rss"></a>
            <% } %>
            <a id="nav-search-btn" class="nav-icon" title="Search" data-i18n-attr="title" data-i18n="nav.search"></a>
          </nav>
          <div id="search-form-wrap">
            <%- search_form({button: '&#xF002;'}) %>
          </div>
        </div>
    </div>
</header>
