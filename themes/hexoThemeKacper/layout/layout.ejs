<%- partial('_partial/head') %>
<body>
<div id="container">

    <%if(page.type !== 'API'){%>
    <div id="wrap">
	   <%- partial('_partial/header') %>
		<main class="outer" id="main-content">
		<%- body %>
		</main>
		<%- partial('_partial/footer') %>
  	</div>
    <%- partial('_partial/mobile-nav', null, {cache: !config.relative_link}) %>
    <%}else{%>
        <main class="article_api" id="main-content">
            <%- body %>
        </main>
    <%}%>
</div>
</body>
</html>

